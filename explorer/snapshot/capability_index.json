 "prosody": {
  "method": {
   "model": "performance = sigmoid(slope_item * (capability_system - difficulty_item))",
   "reference": "Epoch Capabilities Index, https://epoch.ai/data/eci-documentation/methodology",
   "anchors": {
    "real speech": 100.0,
    "zonos2_accurate": 50.0
   },
   "dimensions": [
    "pace",
    "pauses",
    "pitch",
    "contour"
   ],
   "metrics": {
    "rhythm_rate_x": {
     "dimension": "pace",
     "performance": "min(1, 1 / rhythm pace \u00d7ceil)"
    },
    "charsec_x": {
     "dimension": "pace",
     "performance": "min(1, 1 / char/s \u00d7ceil)"
    },
    "paired_dur": {
     "dimension": "pace",
     "performance": "1 / (1 + paired Dur |log2|)",
     "set": "zero_shot_voxblink"
    },
    "rhythm_x": {
     "dimension": "pauses",
     "performance": "min(1, 1 / rhythm pause \u00d7ceil)"
    },
    "paired_pause": {
     "dimension": "pauses",
     "performance": "1 / (1 + paired Pause \u0394)",
     "set": "zero_shot_voxblink"
    },
    "pitch_range_x": {
     "dimension": "pitch",
     "performance": "min(1, 1 / pitch range \u00d7ceil)"
    },
    "paired_range": {
     "dimension": "pitch",
     "performance": "1 / (1 + paired Range |log2|)",
     "set": "zero_shot_voxblink"
    },
