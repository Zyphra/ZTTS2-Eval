# ZTTS2-Eval environment variables. Copy to .env and edit, or `export` directly.
# Every variable has a sensible default unless noted; only set what you need.

# ---- Evaluation output --------------------------------------------------------
# Where scoring reads/writes generated audio + score files (run_infer_*_eval.sh).
DECODE_DIR=results/clean

# ---- Qwen3-ASR server (WER scoring; scripts/serve_asr.sh) ---------------------
# ASR_GPU is auto-picked (GPU with enough free memory) if unset.
#ASR_GPU=0
#ASR_HOST=127.0.0.1
#ASR_PORT=8000
#ASR_MODEL=Qwen/Qwen3-ASR-1.7B
#ASR_BASE_URL=http://127.0.0.1:8000/v1
#ASR_GPU_MEM_UTIL=0.9
#ASR_STARTUP_TIMEOUT=600
#ASR_CONCURRENCY=16

# ---- Per-language ASR routing (utils/run_wer.py; see docs/asr_whisper_vs_qwen.md)
# The published WER numbers are ROUTED: with WHISPER_BASE_URL set, langs NOT in
# QWEN_LANGS are transcribed by a forced-language Whisper large-v3 server instead
# of Qwen3-ASR (this moves per-lang WER by 8-72 points on the tail langs). With
# WHISPER_BASE_URL unset, everything scores on Qwen — NOT comparable with
# RESULTS_CURRENT.md. slurm/eval_job.sh and scripts/serve_asr.sh export these
# themselves; set them only for manual scoring runs.
#WHISPER_BASE_URL=http://127.0.0.1:8001/v1
#WHISPER_MODEL=openai/whisper-large-v3
#QWEN_LANGS=en zh ko th vi hi fa yo

# ---- WER text normalization (utils/text_norm.py) ------------------------------
# Pronunciation-neutral orthographic folding for abjad scripts, applied to ref
# and hyp alike before WER. The published numbers use the default; set empty
# ("") to disable all folding.
#ORTHO_NORM_LANGS=ar fa he

# ---- vLLM-Omni server (local TTS generation; scripts/serve_omni.sh) -----------
#OMNI_GPU=0
#OMNI_HOST=127.0.0.1
#OMNI_PORT=8001
#OMNI_BASE_URL=http://127.0.0.1:8001/v1
#OMNI_STARTUP_TIMEOUT=600

# ---- VoxBlink2 set preparation (scripts/prepare_voxblink2_eval_stage_*.py) ----
# Only needed to (re)build data/in-the-wild/ from a local VoxBlink2 copy.
#VOXBLINK2_AUDIO_ROOT=/path/to/VoxBlink2/audio
#VOXBLINK2_ENRICHED=/path/to/voxblink2_enriched.pkl

# ---- Hosted-provider API keys (only the provider you generate with) -----------
#GEMINI_API_KEY=        # or GOOGLE_API_KEY
#ELEVENLABS_API_KEY=
#CARTESIA_API_KEY=
#INWORLD_API_KEY=

# ---- HuggingFace (FLEURS-R download in scripts/prepare_fleurs_r.py) ------------
# Use `huggingface-cli login` or set a token to access google/fleurs-r.
#HF_TOKEN=
