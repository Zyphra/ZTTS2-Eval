# ZTTS2-Eval environment variables. Copy to .env and edit, or `export` directly.
# Every variable has a default unless noted (shown here); only set what you need.
# SLURM-internal knobs (METRICS_*, GEN_*, Z3_*, EJ_*, RESCORE_*, RELEASE_*, GT_*) are
# documented in slurm/README.md, not here.

# ---- API keys ------------------------------------------------------------------
# Hosted providers (only the provider you generate with).
#GEMINI_API_KEY=            # or GOOGLE_API_KEY
#ELEVENLABS_API_KEY=
#CARTESIA_API_KEY=
#INWORLD_API_KEY=
# Hugging Face: google/fleurs-r (scripts/prep/prepare_fleurs_r.py) and the dataset
# upload (scripts/prep/upload_release_data.py). `huggingface-cli login` also works.
#HF_TOKEN=

# ---- ASR server (Qwen3-ASR; scripts/score/serve_asr.sh) -------------------------
# ASR_GPU unset = auto-pick a GPU with at least ASR_GPU_MIN_FREE_MIB free (else GPU 0).
#ASR_GPU=0
#ASR_GPU_MIN_FREE_MIB=50000
#ASR_HOST=127.0.0.1
#ASR_PORT=8000
#ASR_MODEL=Qwen/Qwen3-ASR-1.7B
#ASR_GPU_MEM_UTIL=0.35
#ASR_STARTUP_TIMEOUT=600
# Preset = use this external server; no server is launched or stopped.
#ASR_BASE_URL=http://127.0.0.1:8000/v1

# ---- Whisper server (Whisper-large-v3 for the routed languages) ----------------
#WHISPER_ASR_MODEL=openai/whisper-large-v3
#WHISPER_PORT=8001
# WHISPER_GPU unset = auto-pick another GPU with enough free memory, else co-locate.
#WHISPER_GPU=
#WHISPER_GPU_MEM_UTIL=0.35
# Preset = use this external server; no server is launched or stopped.
#WHISPER_BASE_URL=http://127.0.0.1:8001/v1

# ---- WER client (scripts/score/run_wer.py, utils/text_norm.py) -------------------
# ASR_ROUTING=0 is a diagnostic all-Qwen mode that build_results.py refuses.
#ASR_ROUTING=1
#QWEN_LANGS=zh ko th vi hi fa
#ASR_CONCURRENCY=16
#ASR_TIMEOUT=60
# Orthographic folding for abjad scripts, applied to ref and hyp alike ("" = off).
#ORTHO_NORM_LANGS=ar fa he

# ---- Scoring (scripts/score/lib_infer_scoring.sh, utils/average_wer.py) ---------
# SCORE_GPU unset = auto-pick a GPU with at least SCORE_GPU_MIN_FREE_MIB free.
#SCORE_GPU=0
#SCORE_GPU_MIN_FREE_MIB=5000
#SCORE_MIN_COVERAGE=0.98

# ---- Server logs (utils/lib_serve.sh) ------------------------------------------
# Set = every server writes ${SERVE_LOG_DIR}/<role>.log; unset = /tmp/<role>_<port>.log.
#SERVE_LOG_DIR=

# ---- TTS servers ---------------------------------------------------------------
# Zonos2 (scripts/gen/serve_zonos2.sh): ZONOS2_HOME is a ZONOS2 checkout with a venv.
#ZONOS2_HOME=
#ZONOS2_PY=$ZONOS2_HOME/.venv/bin/python
#ZONOS2_PORT=1919
# ZONOS3 Mini (scripts/gen/serve_zonos3.sh): ZONOS3_HOME is the release minisgl checkout.
#ZONOS3_HOME=
#ZONOS3_ENV=                # optional site env script sourced before the server
#ZONOS3_MODEL=hf://Zyphra/ZONOS3_Mini_release_ckpts/lm/mect_60k
#ZONOS3_PY=                 # empty = ${PYTHON:-$ZONOS3_HOME/.venv/bin/python}
#ZONOS3_SERVE_ARGS=         # extra server flags, e.g. --laci-heads ...
#ZONOS3_PORT=1920
# vLLM-Omni (scripts/gen/serve_omni.sh)
#OMNI_PORT=8091
#OMNI_STARTUP_TIMEOUT=1800
#OMNI_VLLM_BIN=vllm-omni
# Audio8 SGLang-Omni (scripts/gen/serve_audio8.sh)
#AUDIO8_PORT=8010

# ---- Model venvs (scripts/setup/setup_<model>_env.sh creates them) ----------------
#OMNI_VENV=.venv
#AUDIO8_VENV=$HOME/.venvs/audio8-sglang
#COSYVOICE_VENV=$HOME/.venvs/cosyvoice
#KOKORO_VENV=$HOME/.venvs/kokoro
#MING3_VENV=$HOME/.venvs/ming3
#MING3_TINY_VENV=$HOME/.venvs/ming3-tiny
#MOSS_TTS_VENV=$HOME/.venvs/moss-tts
#NEUTTS_VENV=$HOME/.venvs/neutts
#PHONON_VENV=$HOME/.venvs/phonon
#POCKET_TTS_VENV=$HOME/.venvs/pocket-tts
#TTSDS_VENV=$HOME/.venvs/ttsds          # MPM span
#VIBEVOICE_VENV=$HOME/.venvs/vibevoice
#VIBEVOICE15_VENV=$HOME/.venvs/vibevoice15

# ---- Setup overrides (scripts/setup/*.sh) ----------------------------------------
# Upstream checkouts: <MODEL>_SRC (clone dir), <MODEL>_REPO (URL), <MODEL>_COMMIT (pin).
#AUDIO8_SRC=third_party/Audio8_TTS
#COSYVOICE_SRC=third_party/CosyVoice
#COSYVOICE_REPO=https://github.com/FunAudioLLM/CosyVoice
#COSYVOICE_COMMIT=074ca6dc9e80a2f424f1f74b48bdd7d3fea531cc
#MING3_SRC=third_party/Ming-3.0-tts
#MING3_REPO=https://github.com/inclusionAI/Ming-3.0-tts
#MING3_COMMIT=a39b80660bdc5a4394d5e1d41af6dbfd9c443a54
#MOSS_TTS_SRC=third_party/MOSS-TTS
#MOSS_TTS_REPO=https://github.com/OpenMOSS/MOSS-TTS
#MOSS_TTS_COMMIT=934d6826b084c46a0d033402174d5f8ac4ed2519
#VIBEVOICE_SRC=third_party/VibeVoice
#VIBEVOICE_REPO=https://github.com/microsoft/VibeVoice
#VIBEVOICE_COMMIT=16fb2cb1217c9934a886e1948ffb06120caa2df5
#VIBEVOICE15_SRC=third_party/VibeVoice-1.5B
# Python version and PyTorch wheel tag of a new venv (defaults differ per script;
# CUDA_TAG=cpu gives a CPU-only Kokoro).
#PY_VER=3.11
#CUDA_TAG=cu128

# ---- Model dirs (generators) -----------------------------------------------------
#COSYVOICE3_DIR=            # CosyVoice3 model dir (default: the local HF cache snapshot)
#MOSS_TTS_DIR=OpenMOSS-Team/MOSS-TTS
#VIBEVOICE_DIR=microsoft/VibeVoice-Realtime-0.5B
#VIBEVOICE_VOICE_DIR=$VIBEVOICE_SRC/demo/voices/streaming_model
#VIBEVOICE15_DIR=microsoft/VibeVoice-1.5B

# ---- Omni knobs (scripts/gen/run_omni.sh) ------------------------------------------
#OMNI_FORCE_REFTEXT=0       # 1 = send the prompt transcript to every model
#OMNI_FORCE_NOREFTEXT=0     # 1 = never send it
#FISH_SPEECH_TREE=          # fish-speech source tree for fish-s2-pro

# ---- VoxBlink2 set preparation (scripts/prep/) -----------------------------------
# Only needed to (re)build data/in-the-wild/ from a local VoxBlink2 copy.
#VOXBLINK2_AUDIO_ROOT=/path/to/VoxBlink2/audio
#VOXBLINK2_ENRICHED=/path/to/voxblink2_enriched.pkl

# ---- Interpreter (utils/lib_common.sh repo_py) -----------------------------------
# Unset = .venv/bin/python if present, else python3.
#PYTHON=
